# Copy to .env and fill in. Every variable has a safe default EXCEPT where
# noted -- the app boots and runs fully in mock/simulation mode with none
# of the credential blocks below filled in.

# --- Core ---
ENVIRONMENT=development
# Local dev default (SQLite, zero setup). For production:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/elevatebox
DATABASE_URL=sqlite+aiosqlite:///./elevatebox.db
LOG_LEVEL=INFO
# Public HTTPS URL of this deployment once hosted -- OmniDimension and Meta
# both need real callback/webhook URLs, so this must be set before wiring
# up either provider. e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=

# --- Agent identity (used verbatim in every WhatsApp message; never hardcoded) ---
AGENT_NAME=Shafiq
AGENT_PHONE=+91-XXXXXXXXXX
# Public URL to a hosted copy of your resume (PDF/DOCX) -- required for the
# "send my resume" part of the WhatsApp payload. No resume file was
# supplied when this repo was generated; host one and put the link here.
RESUME_URL=
# Public URL to docs/architecture.png once this repo (or just that file)
# is hosted somewhere reachable -- required so it can be sent as a WhatsApp
# image header rather than a local file path.
ARCHITECTURE_IMAGE_URL=

# --- OmniDimension (voice + telephony) ---
# Get these from https://omnidim.io -> your agent's dashboard.
OMNIDIMENSION_API_KEY=
OMNIDIMENSION_AGENT_ID=
# Optional: a specific caller-ID/from-number if you've provisioned one
# (e.g. via SIP trunk import from Twilio/Exotel). Leave blank to use
# whatever default number your OmniDimension account provides.
OMNIDIMENSION_FROM_NUMBER_ID=
# The number from the assignment PDF -- already correct, override only if
# testing against a different number.
EVALUATOR_PHONE_E164=+918688664337

# --- WhatsApp Cloud API (Meta) ---
# From https://developers.facebook.com -> your App -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Names of your APPROVED message templates (see README "WhatsApp Setup" --
# business-initiated messages require a pre-approved template; these are
# just the names you gave them in Meta's template manager).
WHATSAPP_MIDCALL_TEMPLATE_NAME=elevatebox_midcall_update
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=elevatebox_followup

# --- LLM (extraction fallback + follow-up polish; NOT on the live-call
# latency path -- OmniDimension's own configured LLM handles turn-by-turn
# conversation) ---
ANTHROPIC_API_KEY=
CONVERSATION_MODEL=claude-haiku-4-5-20251001
EXTRACTION_MODEL=claude-sonnet-5
